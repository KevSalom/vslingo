# Copy this file to .env and replace only the values you are authorized to use.
# Leave optional provider credentials blank until live smokes are explicitly approved.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:4321

# Identity and local persistence. Fake auth is restricted to development/test.
AUTH_MODE=fake
DATABASE_PATH=data/ingles-al-grano.db
SQLITE_BUSY_TIMEOUT_MS=5000
WS_TICKET_TTL_SECONDS=30

# Versioned commercial offer. Existing periods retain their granted snapshot.
PRODUCT_CONFIG_VERSION=1
PRODUCT_PLAN_CODE=monthly_v1
PRODUCT_CURRENCY=USD
PRODUCT_PRICE_MINOR=299
TRIAL_VOICE_SECONDS=600
TRIAL_VOICE_TURNS=30
TRIAL_WRITINGS=10
TRIAL_VIDEOS=3
MONTHLY_VOICE_SECONDS=3600
MONTHLY_VOICE_TURNS=180
MONTHLY_WRITINGS=100
MONTHLY_VIDEOS=20

# Required only with AUTH_MODE=clerk. Keep server credentials out of the frontend.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Billing. Fake is local/test only; sandbox and live require separate PayPal apps.
BILLING_MODE=fake
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
PAYPAL_MERCHANT_ID=
BILLING_RETURN_URL=http://localhost:4321/app/cuenta?billing=return
BILLING_CANCEL_URL=http://localhost:4321/app/cuenta?billing=cancelled

# OpenRouter: required for live Writing corrections and the explicit STT/chat smokes.
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_LLM_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Microsoft Edge Neural: no Azure SDK credential is required.
EDGE_TTS_VOICE=en-US-AriaNeural
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_ACQUIRE_TIMEOUT_SECONDS=1

# T09 process-local protections. Lower values can be injected in tests.
MAX_HTTP_REQUESTS_PER_MINUTE=30
MAX_SPEECH_REQUESTS_PER_MINUTE=10
MAX_WS_CONNECTIONS=20
MAX_WS_CONNECTIONS_PER_IP=2
MAX_VOICE_SESSION_SECONDS=900
MAX_VOICE_TURNS=30
MAX_AUDIO_SECONDS=60
MAX_AUDIO_BYTES=2000044
MAX_CONCURRENT_STT=4
MAX_CONCURRENT_LLM=8
MAX_CONCURRENT_TTS=4
MAX_CONCURRENT_VIDEO=4
