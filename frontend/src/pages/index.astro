---
import SiteFonts from '../components/SiteFonts.astro';
import MarketingConsentStatic from '../components/MarketingConsentStatic.astro';
import PwaBootstrap from '../components/PwaBootstrap.astro';
import PwaHead from '../components/PwaHead.astro';
import '../styles/global.css';

const title = 'Inglés al Grano | Practica el inglés que ya sabes';
const description =
  'Habla a tu ritmo, mejora lo que escribes y entrena el oído con videos. Explicaciones en español, directo al punto.';
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL('/', site);
const image = new URL('/og-vslingo.svg', site);
const apiBaseUrl = import.meta.env.PUBLIC_API_URL?.trim() || 'http://127.0.0.1:8000';
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Inglés al Grano',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  description,
  offers: { '@type': 'Offer', price: '2.99', priceCurrency: 'USD' },
  url: canonical.href,
  inLanguage: 'es',
});
const waveform = [22, 38, 58, 34, 78, 46, 70, 32, 62, 89, 49, 30, 66, 44, 81, 51, 28, 72, 45, 88, 59, 35, 75, 47, 63, 29, 54, 40];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Inglés al Grano: práctica directa para nivel intermedio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <PwaHead />
    <script is:inline>
      (function () {
        var VALID = ['light', 'dark'];
        try {
          var saved = localStorage.getItem('vslingo:theme');
          document.documentElement.setAttribute('data-theme', VALID.indexOf(saved) !== -1 ? saved : 'light');
        } catch (_) { document.documentElement.setAttribute('data-theme', 'light'); }
      })();
    </script>
    <SiteFonts />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <title>{title}</title>
  </head>
  <body>
    <MarketingConsentStatic />
    <PwaBootstrap />
    <div class="site-shell">
      <header class="site-container site-header">
        <a class="brand" href="#inicio" aria-label="Inglés al Grano, inicio">
          <span aria-hidden="true" class="brand-mark">IA</span>
          Inglés al Grano
        </a>
        <nav class="header-nav" aria-label="Navegación principal">
          <a class="text-link header-wide-link" href="#modulos">Cómo practicas</a>
          <a class="text-link header-wide-link" href="#precio">Precio</a>
          <a class="text-link" href="/app">Entrar</a>
          <button aria-label="Activar modo oscuro" class="theme-toggle" id="theme-toggle" title="Activar modo oscuro" type="button">
            <svg aria-hidden="true" class="theme-icon theme-icon-moon" fill="none" viewBox="0 0 24 24"><path d="M20 15.4A8 8 0 0 1 8.6 4a8 8 0 1 0 11.4 11.4Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"></path></svg>
            <svg aria-hidden="true" class="theme-icon theme-icon-sun" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.7"></circle><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path></svg>
          </button>
          <a class="cta header-cta" href="/app/hablar">Probar gratis</a>
        </nav>
      </header>

      <main id="inicio">
        <section class="site-container hero" aria-labelledby="hero-title">
          <div>
            <p class="eyebrow">Práctica para nivel B1-C1</p>
            <h1 class="landing-title" id="hero-title">Ya sabes inglés. Ahora practícalo.</h1>
            <p class="hero-copy">Habla a tu ritmo, mejora lo que escribes y entrena el oído con videos. <strong>Cuando quieras, sin perder el tiempo.</strong> Explicaciones en español, directo al punto.</p>
            <div class="hero-actions">
              <a class="cta" href="/app/hablar">Probar gratis</a>
              <a class="cta cta-secondary" href="/app">Entrar</a>
            </div>
            <p class="note" data-plan="trial-summary">Prueba única sin tarjeta · 10 minutos de voz · 10 correcciones · 3 videos</p>
          </div>
          <div class="signature-frame" aria-label="Tres prácticas conectadas: voz, escritura y video">
            <div class="signature-stage" aria-hidden="true">
              <div class="signature-panel">
                <p class="signature-label">Habla y recibe una mejora</p>
                <div class="waveform-diff">
                  {waveform.map((height, index) => <span style={`--i: ${index}; height: ${height}%`}></span>)}
                </div>
              </div>
              <div class="signature-panel">
                <p class="signature-label">Mira el cambio y entiende por qué</p>
                <div class="signature-writing">
                  <p class="sig-diff sig-diff-remove"><span>−</span>I deploy the fix yesterday</p>
                  <p class="sig-diff sig-diff-add"><span>+</span>I deployed the fix yesterday</p>
                </div>
              </div>
              <div class="signature-panel">
                <p class="signature-label">Escucha, sigue y guarda una nota</p>
                <div class="signature-video">
                  <span class="sig-play">▶</span>
                  <div class="sig-video-meta">
                    <span class="sig-track"></span>
                    <span class="sig-caption"></span>
                    <span class="sig-caption sig-caption-short"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="landing-section landing-proof" aria-labelledby="proof-title">
          <div class="site-container proof-grid">
            <div>
              <p class="section-kicker">Una mejora cada vez</p>
              <h2 class="section-title" id="proof-title">Corrige lo importante. Sigue hablando.</h2>
              <p class="section-copy">No tienes que volver a clases ni memorizar otra lista. Practicas una situación real y recibes una explicación breve en español.</p>
            </div>
            <article class="proof-card" aria-label="Ejemplo de corrección de una actualización diaria">
              <header class="proof-header"><span>Tu actualización</span><span>1 mejora</span></header>
              <p class="diff-line diff-remove"><span class="diff-symbol">−</span><del>Yesterday I deploy the API and the tests was passing.</del></p>
              <p class="diff-line diff-add"><span class="diff-symbol">+</span><ins>Yesterday I deployed the API, and all tests passed.</ins></p>
              <p class="proof-explanation">Usa pasado simple para contar lo que terminaste ayer.</p>
            </article>
          </div>
        </section>

        <section class="landing-section" id="modulos" aria-labelledby="modules-title">
          <div class="site-container">
            <p class="section-kicker">Tres formas de practicar</p>
            <h2 class="section-title" id="modules-title">Elige una práctica, no una racha.</h2>
            <p class="section-copy">Entra directamente a lo que necesitas hoy. Los tres módulos permanecen visibles y comparten una misma experiencia tranquila.</p>
            <div class="module-grid module-explorer">
              <a class="module-card module-link featured" href="/app/hablar">
                <span class="module-label">Conversación</span>
                <div class="module-preview voice-preview" aria-hidden="true">
                  <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                  <em>tu voz → respuesta → mejora</em>
                </div>
                <h3>Hablar</h3>
                <p>Practica a tu ritmo con un tema libre o una situación cotidiana. Mantén pulsado, habla y recibe una respuesta.</p>
                <span class="module-link-cta">Empezar a hablar <b aria-hidden="true">→</b></span>
              </a>
              <a class="module-card module-link" href="/app/escribir">
                <span class="module-label">Escritura</span>
                <div class="module-preview diff-preview" aria-hidden="true">
                  <span>− I deploy the fix</span>
                  <span>+ I deployed the fix</span>
                </div>
                <h3>Escribir</h3>
                <p>Mejora un mensaje, correo o texto corto. Compara el cambio y entiende la explicación sin jerga.</p>
                <span class="module-link-cta">Mejorar un texto <b aria-hidden="true">→</b></span>
              </a>
              <a class="module-card module-link" href="/app/videos">
                <span class="module-label">Comprensión</span>
                <div class="module-preview video-preview" aria-hidden="true">
                  <span class="video-play">▶</span><span class="video-track"></span><span class="video-caption"></span><span class="video-caption short"></span>
                </div>
                <h3>Videos</h3>
                <p>Sigue una transcripción, vuelve al segundo que te costó y guarda una nota para repasarla después.</p>
                <span class="module-link-cta">Entrenar el oído <b aria-hidden="true">→</b></span>
              </a>
            </div>
          </div>
        </section>

        <section class="landing-section" id="sin-ruido" aria-labelledby="focus-title">
          <div class="site-container">
            <p class="section-kicker">Para quien ya tiene base</p>
            <h2 class="section-title" id="focus-title">Cero rachas, gemas y rutas falsas.</h2>
            <div class="contrast-grid">
              <article class="contrast-card contrast-out">
                <h3>Lo que dejamos fuera</h3>
                <ul class="contrast-list">
                  <li><span aria-hidden="true">−</span>Lecciones desde cero</li>
                  <li><span aria-hidden="true">−</span>Puntos, ligas y castigos diarios</li>
                  <li><span aria-hidden="true">−</span>Rutas genéricas que deciden por ti</li>
                </ul>
              </article>
              <article class="contrast-card contrast-in">
                <h3>Lo que sí encuentras</h3>
                <ul class="contrast-list">
                  <li><span aria-hidden="true">+</span>Práctica cuando la necesitas</li>
                  <li><span aria-hidden="true">+</span>Explicaciones claras en español</li>
                  <li><span aria-hidden="true">+</span>Tu historial para retomar después</li>
                </ul>
              </article>
            </div>
          </div>
        </section>

        <section class="landing-section" id="como-funciona" aria-labelledby="pipeline-title">
          <div class="site-container">
            <p class="section-kicker">Cómo funciona</p>
            <h2 class="section-title" id="pipeline-title">Practica en tres pasos cortos.</h2>
            <div class="pipeline-grid">
              <div class="pipeline-step"><strong>01 · Elige</strong><span>Abre Hablar, Escribir o Videos según lo que quieras entrenar.</span></div>
              <div class="pipeline-step"><strong>02 · Practica</strong><span>Usa una situación real, sin cuestionario de nivel ni configuración obligatoria.</span></div>
              <div class="pipeline-step"><strong>03 · Mejora</strong><span>Recibe una explicación directa y vuelve a intentarlo cuando quieras.</span></div>
            </div>
          </div>
        </section>

        <section class="landing-section" id="precio" aria-labelledby="price-title">
          <div class="site-container pricing-wrap">
            <div>
              <p class="section-kicker">Un solo plan</p>
              <h2 class="section-title" id="price-title">Todo el espacio para practicar.</h2>
              <p class="section-copy">Empieza con una prueba gratuita sin tarjeta. Si te sirve, continúa con el mismo plan cada mes.</p>
            </div>
            <article class="price-card">
              <p class="price-name">Inglés al Grano</p>
              <p class="price"><strong data-plan="price">US$2,99</strong><span>/mes</span></p>
              <ul class="price-list">
                <li data-plan="monthly-voice">60 minutos de tu voz, hasta 180 intervenciones</li>
                <li data-plan="monthly-writing">100 correcciones terminadas</li>
                <li data-plan="monthly-video">20 videos nuevos con transcripción</li>
                <li>Historial, notas y voces en inglés</li>
              </ul>
              <a class="cta price-cta" href="/app/hablar">Probar gratis</a>
              <p class="note">Sin tarjeta para probar. Verás renovación y cancelación antes de pagar.</p>
            </article>
          </div>
        </section>

        <section class="landing-section" aria-labelledby="privacy-title">
          <div class="site-container assurance-grid">
            <article class="assurance-card">
              <p class="section-kicker">Procesamiento efímero</p>
              <h2 id="privacy-title">Tu audio sirve para responderte, no para llenar una biblioteca.</h2>
              <p>No guardamos WAV ni MP3. Tu texto, historial y notas quedan asociados a tu cuenta para que puedas retomarlos o borrarlos.</p>
            </article>
            <article class="assurance-card">
              <p class="section-kicker">Una voz que continúa</p>
              <h2>Si la voz principal falla, conservas la respuesta.</h2>
              <p>El navegador puede leer los segmentos pendientes. La calidad depende de tu dispositivo; el texto siempre permanece disponible.</p>
            </article>
          </div>
        </section>

        <section class="site-container final-cta" aria-labelledby="final-title">
          <div>
            <p class="section-kicker">Cuando quieras</p>
            <h2 class="section-title" id="final-title">Entra y practica lo que ya sabes.</h2>
          </div>
          <a class="cta" href="/app/hablar">Probar gratis</a>
        </section>
      </main>

      <footer class="site-container site-footer">
        <span>Inglés al Grano · práctica intermedia sin rodeos</span>
        <span><a href="/app">Entrar</a> · <a data-plan="footer-price" href="#precio">US$2,99/mes</a></span>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        function updateLabel() {
          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          var label = isDark ? 'Activar modo claro' : 'Activar modo oscuro';
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
        }
        button.addEventListener('click', function () {
          var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('vslingo:theme', next); } catch (_) {}
          updateLabel();
        });
        updateLabel();
      })();
    </script>
    <script is:inline define:vars={{ apiBaseUrl }}>
      (function () {
        function setText(selector, text) {
          var element = document.querySelector(selector);
          if (element) element.textContent = text;
        }
        fetch(apiBaseUrl.replace(/\/$/, '') + '/api/plan')
          .then(function (response) {
            if (!response.ok) throw new Error('plan unavailable');
            return response.json();
          })
          .then(function (plan) {
            var price = 'US$' + (plan.price_minor / 100).toLocaleString('es', {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            });
            var trialMinutes = Math.floor(plan.trial.voice_seconds / 60);
            var monthlyMinutes = Math.floor(plan.monthly.voice_seconds / 60);
            setText('[data-plan="price"]', price);
            setText('[data-plan="footer-price"]', price + '/mes');
            setText('[data-plan="trial-summary"]', 'Prueba única sin tarjeta · ' + trialMinutes + ' minutos de voz · ' + plan.trial.writings + ' correcciones · ' + plan.trial.videos + ' videos');
            setText('[data-plan="monthly-voice"]', monthlyMinutes + ' minutos de tu voz, hasta ' + plan.monthly.voice_turns + ' intervenciones');
            setText('[data-plan="monthly-writing"]', plan.monthly.writings + ' correcciones terminadas');
            setText('[data-plan="monthly-video"]', plan.monthly.videos + ' videos nuevos con transcripción');
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
