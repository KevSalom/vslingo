# Public URL of the FastAPI backend. Embedded in the static build (no secrets).
# Used by REST (/api/writing, /api/video, /api/speech) and Voice WebSocket
# (derived as ws[s]://<host>/api/voice/ws). Required in production builds.
PUBLIC_API_URL=http://127.0.0.1:8000

# Local development works without an external account. Production uses Clerk.
PUBLIC_AUTH_MODE=fake
PUBLIC_CLERK_PUBLISHABLE_KEY=
