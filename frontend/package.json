{
  "name": "vslingo-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/copy-vad-assets.js",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "pnpm run check && pnpm run test && pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:edge": "playwright test --project=edge",
    "audit:lighthouse": "pnpm run build && lhci autorun",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@ricky0123/vad-web": "0.0.30",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@fontsource-variable/sora": "5.2.8",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.50.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
